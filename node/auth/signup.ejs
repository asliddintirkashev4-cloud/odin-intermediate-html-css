<%- include('../views/header') %><p>Use a learning account. The same account works across these server projects.</p><form method="POST" action="<%= base %>/signup"><input type="hidden" name="_csrf" value="<%= csrf %>"><label for="firstName">First name</label><input id="firstName" name="firstName" required maxlength="80" autocomplete="given-name" value="<%= values.firstName || '' %>"><label for="lastName">Last name</label><input id="lastName" name="lastName" required maxlength="80" autocomplete="family-name" value="<%= values.lastName || '' %>"><label for="email">Email</label><input id="email" name="email" type="email" required maxlength="254" autocomplete="email" value="<%= values.email || '' %>"><label for="password">Password</label><input id="password" name="password" type="password" required minlength="10" autocomplete="new-password"><label for="confirmPassword">Confirm password</label><input id="confirmPassword" name="confirmPassword" type="password" required autocomplete="new-password"><button>Create account</button></form><a href="<%= base %>/login">Already have an account?</a><%- include('../views/footer') %>

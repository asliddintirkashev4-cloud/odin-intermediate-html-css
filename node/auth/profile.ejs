<%- include('../views/header') %><%- include('nav') %><form method="POST" action="<%= base %>/profile"><input type="hidden" name="_csrf" value="<%= csrf %>"><label for="firstName">First name</label><input id="firstName" name="firstName" required maxlength="80" value="<%= values.firstName || '' %>"><label for="lastName">Last name</label><input id="lastName" name="lastName" required maxlength="80" value="<%= values.lastName || '' %>"><label for="bio">Bio</label><textarea id="bio" name="bio" maxlength="200"><%= values.bio || '' %></textarea><label for="avatar">Profile image URL (optional, HTTPS)</label><input id="avatar" name="avatar" type="url" value="<%= values.avatar || '' %>"><button>Save profile</button></form><%- include('../views/footer') %>

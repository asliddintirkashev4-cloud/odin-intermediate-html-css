<%- include('../views/header') %><p>Manage a small stationery collection. Every item belongs to one category. Categories containing items are protected from deletion.</p><div class="actions"><a class="button" href="<%= base %>/items/new">Add item</a><a href="<%= base %>/categories/new">Add category</a></div><h2>Categories</h2><div class="grid"><% categories.forEach(category => { %><article><h3><a href="<%= base %>/categories/<%= category.id %>"><%= category.name %></a></h3><p><%= category.description %></p><small><%= category.items %> items</small></article><% }) %></div><h2>All items</h2><%- include('items', { items }) %><%- include('../views/footer') %>

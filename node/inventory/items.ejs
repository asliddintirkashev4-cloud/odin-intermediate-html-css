<% if (!items.length) { %><p class="empty">No items yet.</p><% } else { %><table><thead><tr><th>Item</th><th>Category</th><th>Price</th><th>Stock</th></tr></thead><tbody><% items.forEach(item => { %><tr><td><a href="<%= base %>/items/<%= item.id %>"><%= item.name %></a></td><td><%= item.category %></td><td>$<%= (item.price_cents / 100).toFixed(2) %></td><td><%= item.stock %></td></tr><% }) %></tbody></table><% } %>

<%- include('../views/header') %><form method="POST" action="<%= base %>/<%= kind %><%= id ? '/' + id : '' %>"><label for="name">Name</label><input id="name" name="name" required maxlength="<%= isItem ? 120 : 80 %>" value="<%= values.name || '' %>"><label for="description">Description</label><textarea id="description" name="description" maxlength="<%= isItem ? 2000 : 500 %>"><%= values.description || '' %></textarea><% if (isItem) { %><label for="category">Category</label><select id="category" name="categoryId" required><option value="">Choose a category</option><% categories.forEach(category => { %><option value="<%= category.id %>" <%= String(values.categoryId) === String(category.id) ? 'selected' : '' %>><%= category.name %></option><% }) %></select><label for="price">Price (USD)</label><input id="price" name="price" type="number" min="0" max="9999999.99" step="0.01" required value="<%= values.price ?? '' %>"><label for="stock">Stock</label><input id="stock" name="stock" type="number" min="0" max="2147483647" step="1" required value="<%= values.stock ?? '' %>"><% } %><label for="passcode">Admin passcode</label><input id="passcode" name="passcode" type="password" autocomplete="off" required><button>Save <%= isItem ? 'item' : 'category' %></button></form><a href="<%= base %>/">Cancel</a><%- include('../views/footer') %>

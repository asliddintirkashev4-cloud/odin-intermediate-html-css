<%- include('../views/header') %><p><%= record.description %></p><% if (isItem) { %><p>Category: <a href="<%= base %>/categories/<%= record.category_id %>"><%= record.category %></a></p><p>$<%= (record.price_cents / 100).toFixed(2) %> · <%= record.stock %> in stock</p><% } else { %><%- include('items', { items }) %><% } %><p><a href="<%= base %>/<%= kind %>/<%= record.id %>/edit">Edit <%= record.name %></a></p><details><summary>Delete this <%= isItem ? 'item' : 'category' %></summary><p>This removes the record. Categories must be empty first.</p><form method="POST" action="<%= base %>/<%= kind %>/<%= record.id %>/delete"><label for="delete-passcode">Admin passcode to confirm deletion</label><input id="delete-passcode" type="password" name="passcode" required autocomplete="off"><button class="danger">Delete <%= isItem ? 'item' : 'category' %></button></form></details><%- include('../views/footer') %>

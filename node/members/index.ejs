<%- include('../views/header') %><p>A members-only message club. Everyone can read; members can discover the people behind the words.</p><%- include('../auth/nav') %><% if (user) { %><div class="actions"><a class="button" href="<%= base %>/new">Write a message</a><a href="<%= base %>/join"><%= user.member ? 'Membership settings' : 'Join the club' %></a><span class="badge"><%= user.admin ? 'Administrator' : user.member ? 'Member' : 'Registered reader' %></span></div><% } %><% if (!messages.length) { %><p class="empty">The room is quiet. Start a conversation.</p><% } %><% messages.forEach(message => { %><article><h2><%= message.title %></h2><p><%= message.text %></p><% if (message.author) { %><small><%= message.author.firstName %> <%= message.author.lastName %> · <%= message.createdAt.toLocaleString('en-GB') %></small><% } else { %><small>Author and date are visible to club members.</small><% } %><% if (user?.admin) { %><form method="POST" action="<%= base %>/messages/<%= message.id %>/delete"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="danger">Delete message</button></form><% } %></article><% }) %><%- include('../views/footer') %>

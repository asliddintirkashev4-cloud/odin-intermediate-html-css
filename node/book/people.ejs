<%- include('../views/header') %><%- include('nav') %><div class="grid"><% people.forEach(person => { const outgoing = requests.find(r => r.followerId === user.id && r.followingId === person.id); const incoming = requests.find(r => r.followerId === person.id && r.followingId === user.id && !r.accepted); %><article><h2><a href="<%= base %>/people/<%= person.id %>"><%= person.firstName %> <%= person.lastName %></a></h2><p><%= person.bio %></p><% if (person.id !== user.id) { %><form method="POST" action="<%= base %>/people/<%= person.id %>/<%= outgoing ? 'unfollow' : 'follow' %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><button><%= outgoing ? outgoing.accepted ? 'Unfollow' : 'Cancel pending request' : 'Request to follow' %></button></form><% if (incoming) { %><p><%= person.firstName %> wants to follow you.</p><form class="inline" method="POST" action="<%= base %>/people/<%= person.id %>/accept"><input type="hidden" name="_csrf" value="<%= csrf %>"><button>Accept request</button></form><form class="inline" method="POST" action="<%= base %>/people/<%= person.id %>/decline"><input type="hidden" name="_csrf" value="<%= csrf %>"><button>Decline</button></form><% } %><% } else { %><small>This is you.</small><% } %></article><% }) %></div><%- include('../views/footer') %>

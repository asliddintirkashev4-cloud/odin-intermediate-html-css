<% if (!posts.length) { %><p class="empty">No posts yet. Write something or follow another reader.</p><% } %><% posts.forEach(post => { %><article><div class="row"><% if (post.author.avatar) { %><img class="avatar" src="<%= post.author.avatar %>" alt="" referrerpolicy="no-referrer"><% } else { %><img class="avatar" src="/assets/avatar.svg" alt=""><% } %><div><a href="<%= base %>/people/<%= post.author.id %>"><strong><%= post.author.firstName %> <%= post.author.lastName %></strong></a><br><time datetime="<%= post.createdAt.toISOString() %>"><%= post.createdAt.toLocaleString('en-GB') %></time></div></div><p><%= post.text %></p><form class="inline" method="POST" action="<%= base %>/posts/<%= post.id %>/<%= post.likes.some(l => l.userId === user.id) ? 'unlike' : 'like' %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><button><%= post.likes.some(l => l.userId === user.id) ? 'Unlike' : 'Like' %> · <%= post.likes.length %></button></form><% if (post.authorId === user.id) { %><form class="inline" method="POST" action="<%= base %>/posts/<%= post.id %>/delete"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="danger">Delete your post</button></form><% } %><h3>Comments · <%= post.comments.length %></h3><% post.comments.forEach(comment => { %><div class="comment"><strong><%= comment.author.firstName %> <%= comment.author.lastName %></strong><p><%= comment.text %></p></div><% }) %><form method="POST" action="<%= base %>/posts/<%= post.id %>/comments"><input type="hidden" name="_csrf" value="<%= csrf %>"><label for="comment-<%= post.id %>">Add a comment</label><textarea id="comment-<%= post.id %>" name="text" maxlength="2000" required></textarea><button>Post comment</button></form></article><% }) %>

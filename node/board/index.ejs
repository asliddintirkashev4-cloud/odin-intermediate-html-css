<%- include('../views/header') %><p>A little space for ideas, questions and good news. Messages are stored in PostgreSQL.</p><a class="button" href="<%= base %>/new">New message</a><% if (!messages.length) { %><p class="empty">No messages yet. Be the first to say hello.</p><% } %><% messages.forEach(message => { %><article><div class="row"><h2><%= message.user %></h2><time datetime="<%= message.added.toISOString() %>"><%= message.added.toLocaleString('en-GB') %></time></div><p><%= message.text %></p><a href="<%= base %>/messages/<%= message.id %>">Open message from <%= message.user %></a></article><% }) %><%- include('../views/footer') %>

<%- include('../views/header') %><div class="actions"><a href="<%= base %>/users/create">Create demo user</a><a href="<%= base %>/">Practice home</a></div><form method="GET" action="<%= base %>/search"><label for="name">Name contains</label><input id="name" name="name" value="<%= search.name || '' %>"><label for="searchEmail">Email contains</label><input id="searchEmail" name="email" value="<%= search.email || '' %>"><button>Search users</button></form><% if (!users.length) { %><p class="empty">No matching users.</p><% } %><% users.forEach(u => { %><article><h2><%= u.first_name %> <%= u.last_name %></h2><p><%= u.email %><%= u.age ? ' · Age ' + u.age : '' %></p><p><%= u.bio %></p><a href="<%= base %>/users/<%= u.id %>/update">Edit demo user</a><form class="inline" method="POST" action="<%= base %>/users/<%= u.id %>/delete"><button class="danger">Delete demo user</button></form></article><% }) %><%- include('../views/footer') %>

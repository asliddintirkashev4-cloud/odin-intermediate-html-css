<%- include('../views/header') %><form method="POST" action="<%= base %>/users/<%= id ? id + '/update' : 'create' %>"><label for="firstName">First name</label><input id="firstName" name="firstName" required maxlength="80" value="<%= values.firstName || '' %>"><label for="lastName">Last name</label><input id="lastName" name="lastName" required maxlength="80" value="<%= values.lastName || '' %>"><label for="email">Email</label><input id="email" name="email" type="email" required value="<%= values.email || '' %>"><label for="age">Age (optional)</label><input id="age" name="age" type="number" min="18" max="120" value="<%= values.age ?? '' %>"><label for="bio">Bio (up to 200 characters)</label><textarea id="bio" name="bio" maxlength="200"><%= values.bio || '' %></textarea><button>Save demo user</button></form><%- include('../views/footer') %>

<%- include('../views/header') %><%- include('../auth/nav') %><p><a href="<%= base %>/">All conversations</a></p><p class="muted"><%= recipient.bio %></p><section aria-label="Conversation"><% if (!messages.length) { %><p class="empty">Say hello to start this conversation.</p><% } %><% messages.forEach(message => { %><article class="<%= message.senderId === user.id ? 'sent' : 'received' %>"><strong><%= message.senderId === user.id ? 'You' : recipient.firstName %></strong><p><%= message.text %></p><time datetime="<%= message.createdAt.toISOString() %>"><%= message.createdAt.toLocaleString('en-GB') %></time></article><% }) %></section><p><small>The latest 100 messages are shown. Refresh to see new replies.</small></p><form method="POST" action="<%= base %>/conversation/<%= recipient.id %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><label for="text">Message to <%= recipient.firstName %></label><textarea id="text" name="text" required maxlength="2000"></textarea><button>Send message</button></form><%- include('../views/footer') %>

<%- include('../views/header') %><%- include('../auth/nav') %><p>A place for a thoughtful exchange. Choose a person to start or continue a conversation.</p><div class="grid"><% people.forEach(person => { %><article><h2><%= person.firstName %> <%= person.lastName %></h2><p><%= person.bio %></p><a class="button" href="<%= base %>/conversation/<%= person.id %>">Message <%= person.firstName %></a></article><% }) %></div><% if (!people.length) { %><p class="empty">No other accounts yet. Another registered reader will appear here.</p><% } %><%- include('../views/footer') %>

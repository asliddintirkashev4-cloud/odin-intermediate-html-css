<%- include('../views/header') %><%- include('../auth/nav') %><form method="POST" action="<%= base %>/upload" enctype="multipart/form-data"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="folderId" value="<%= folder.id %>"><label for="file">Upload a file (maximum 5 MB)</label><input id="file" name="file" type="file" required accept=".txt,.pdf,.png,.jpg,.jpeg"><p><small>PNG, JPEG, PDF or UTF-8 text. File content is checked on the server.</small></p><button>Upload file</button></form><% if (!files.length) { %><p class="empty">This folder is empty.</p><% } %><ul><% files.forEach(file => { %><li><a href="<%= base %>/items/<%= file.id %>"><%= file.name %></a> · <%= (file.size / 1024).toFixed(1) %> KB</li><% }) %></ul><details><summary>Folder settings</summary><form method="POST" action="<%= base %>/folders/<%= folder.id %>/rename"><input type="hidden" name="_csrf" value="<%= csrf %>"><label for="name">Folder name</label><input id="name" name="name" required maxlength="120" value="<%= folder.name %>"><button>Rename folder</button></form><form method="POST" action="<%= base %>/folders/<%= folder.id %>/delete"><input type="hidden" name="_csrf" value="<%= csrf %>"><p>Only empty folders can be deleted.</p><button class="danger">Delete empty folder</button></form></details><%- include('../views/footer') %>

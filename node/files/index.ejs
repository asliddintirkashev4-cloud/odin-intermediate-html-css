<%- include('../views/header') %><%- include('../auth/nav') %><p>Private folders for small documents. Uploads stay with your account; downloads require sign-in.</p><form method="POST" action="<%= base %>/folders"><input type="hidden" name="_csrf" value="<%= csrf %>"><label for="name">New folder name</label><input id="name" name="name" required maxlength="120"><button>Create folder</button></form><div class="grid"><% folders.forEach(folder => { %><article><h2><a href="<%= base %>/folders/<%= folder.id %>"><%= folder.name %></a></h2><small><%= folder._count.files %> files</small></article><% }) %></div><% if (!folders.length) { %><p class="empty">Create a folder to get started.</p><% } %><%- include('../views/footer') %>

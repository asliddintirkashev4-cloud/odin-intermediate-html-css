{
  "name": "odin-server-projects",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "start:info": "node basic-site/index.js",
    "start:info-express": "node basic-site/express.js",
    "db:setup": "node --env-file-if-exists=.env scripts/setup.js",
    "test": "node --env-file-if-exists=.env --test tests/*.test.js",
    "prisma:generate": "node --env-file-if-exists=.env node_modules/prisma/build/index.js generate",
    "prisma:migrate": "node --env-file-if-exists=.env node_modules/prisma/build/index.js migrate deploy"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@quixo3/prisma-session-store": "3.1.21",
    "bcrypt": "6.0.0",
    "connect-pg-simple": "10.0.0",
    "cors": "2.8.6",
    "ejs": "7.0.1",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "express-session": "1.19.0",
    "express-validator": "7.3.2",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "multer": "2.4.0",
    "passport": "0.7.0",
    "passport-local": "1.0.0",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "prisma": "7.10.1",
    "supertest": "7.3.1"
  }
}
